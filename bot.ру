# ========== БАЗА ДАННЫХ ==========
def init_db():
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        username TEXT,
        voice TEXT DEFAULT 'old_man',
        registered_at TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        text TEXT,
        voice TEXT,
        created_at TEXT
    )''')
    conn.commit()
    conn.close()

init_db()

# ========== ФУНКЦИИ БД ==========
def get_user_voice(user_id):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('SELECT voice FROM users WHERE user_id = ?', (user_id,))
    row = c.fetchone()
    if not row:
        now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        c.execute('INSERT INTO users (user_id, voice, registered_at) VALUES (?, ?, ?)', (user_id, "old_man", now))
        conn.commit()
        conn.close()
        return "old_man"
    conn.close()
    return row[0]

def set_user_voice(user_id, voice):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('UPDATE users SET voice = ? WHERE user_id = ?', (voice, user_id))
    conn.commit()
    conn.close()

def save_history(user_id, text, voice):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    c.execute('INSERT INTO history (user_id, text, voice, created_at) VALUES (?, ?, ?, ?)',
              (user_id, text[:500], voice, now))
    conn.commit()
    conn.close()

def get_history(user_id, limit=10):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    history = c.execute('SELECT id, text, voice, created_at FROM history WHERE user_id = ? ORDER BY id DESC LIMIT ?', (user_id, limit)).fetchall()
    conn.close()
    return history

def delete_history(user_id, history_id=None):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    if history_id:
        c.execute('DELETE FROM history WHERE id = ? AND user_id = ?', (history_id, user_id))
    else:
        c.execute('DELETE FROM history WHERE user_id = ?', (user_id,))
    conn.commit()
    conn.close()

