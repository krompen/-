    user_id = update.effective_user.id
    current_voice = get_user_voice(user_id)
    current_voice_name = VOICES.get(current_voice, VOICES["old_man"])["name"]
    
    await update.message.reply_text(
        f"🎤 TTS БОТ — ТЕКСТ В ГОЛОС\n\n"
        f"🎙️ ТЕКУЩИЙ ГОЛОС: {current_voice_name}\n"
        f"📝 МАКСИМУМ: 500 СИМВОЛОВ\n\n"
        f"⬇️ ВЫБЕРИ ДЕЙСТВИЕ ИЛИ ПРОСТО ПИШИ ТЕКСТ:",
        reply_markup=main_keyboard()
    )

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
