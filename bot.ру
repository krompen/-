# ========== TTS ФУНКЦИЯ ==========
async def text_to_voice(update: Update, context: ContextTypes.DEFAULT_TYPE, text: str, voice_id: str):
    if not TTS_AVAILABLE:
        return "❌ ОШИБКА: УСТАНОВИТЕ gTTS: pip install gTTS"
    
    if len(text) > 500:
        return "❌ МАКСИМУМ 500 СИМВОЛОВ!"
    
    if not text.strip():
        return "❌ ТЕКСТ НЕ МОЖЕТ БЫТЬ ПУСТЫМ!"
    
    voice = VOICES.get(voice_id, VOICES["old_man"])
    
    try:
        from gtts import gTTS
        tts = gTTS(text=text, lang=voice["lang"], slow=voice["slow"])
        audio_bytes = io.BytesIO()
        tts.write_to_fp(audio_bytes)
        audio_bytes.seek(0)
        
        await update.message.reply_voice(voice=audio_bytes, filename="voice.ogg")
        save_history(update.effective_user.id, text, voice_id)
        
        return f"✅ ГОТОВО! (ГОЛОС: {voice['name']})"
    except Exception as e:
        return f"❌ ОШИБКА: {str(e)[:100]}"

