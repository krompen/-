# ========== TTS ФУНКЦИЯ ==========
async def text_to_voice(update: Update, context: ContextTypes.DEFAULT_TYPE, text: str, voice_id: str):
    if not TTS_AVAILABLE:
        return "❌ ОШИБКА: gTTS НЕ УСТАНОВЛЕН! Установи: pip install gTTS"
    
    if len(text) > 500:
        return "❌ ТЕКСТ СЛИШКОМ ДЛИННЫЙ! МАКСИМУМ 500 СИМВОЛОВ."
    
    if not text.strip():
        return "❌ ТЕКСТ НЕ МОЖЕТ БЫТЬ ПУСТЫМ!"
    
    voice = VOICES.get(voice_id, VOICES["old_man"])
    
    try:
        # Генерируем голосовое с выбранными параметрами
        tts = gTTS(text=text, lang=voice["lang"], slow=voice["slow"])
        audio_bytes = io.BytesIO()
        tts.write_to_fp(audio_bytes)
        audio_bytes.seek(0)
        
        # Отправляем
        await update.message.reply_voice(voice=InputFile(audio_bytes, filename="voice.ogg"))
        
        # Сохраняем в историю
        save_history(update.effective_user.id, text, voice_id)
        
        return f"✅ ГОЛОСОВОЕ ОТПРАВЛЕНО! (ГОЛОС: {voice['name']})"
    except Exception as e:
        return f"❌ ОШИБКА: {str(e)[:100]}"

