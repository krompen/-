            await query.edit_message_text("📭 ИСТОРИЯ ПУСТА", reply_markup=back_keyboard())
            return
        
        text = "📋 ИСТОРИЯ:\n\n"
        for h in history[:10]:
            voice_name = VOICES.get(h[2], VOICES["old_man"])["name"]
            text += f"#{h[0]} | {voice_name}\n📝 {h[1][:40]}\n📅 {h[3][:10]}\n\n"
        
        keyboard = []
        for h in history[:5]:
