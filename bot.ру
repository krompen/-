# -*- coding: utf-8 -*-
"""
Support Bot - Анти-спамблок поддержка @vultures_maniac
"""

import sqlite3
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, CallbackQueryHandler, filters, ContextTypes
from telegram.constants import ParseMode

# ==================== КОНФИГУРАЦИЯ ====================
BOT_TOKEN = "8777122035:AAGryE2rwJ6YDcbqelXQMoqxqqVOSK-uaEc"
ADMIN_ID = 8025648373
ADMIN_USERNAME = "@vultures_maniac"

DB_NAME = "support_vm.db"

# ==================== БАЗА ДАННЫХ ====================
def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        c = conn.cursor()
        c.execute('''CREATE TABLE IF NOT EXISTS banned (
            user_id INTEGER PRIMARY KEY
        )''')
        c.execute('''CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            username TEXT,
            text TEXT,
            replied INTEGER DEFAULT 0,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )''')
        conn.commit()

init_db()

def is_banned(user_id: int) -> bool:
    with sqlite3.connect(DB_NAME) as conn:
        c = conn.cursor()
        c.execute('SELECT 1 FROM banned WHERE user_id = ?', (user_id,))
        return c.fetchone() is not None

def ban_user(user_id: int):
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute('INSERT OR IGNORE INTO banned (user_id) VALUES (?)', (user_id,))
        conn.commit()

def unban_user(user_id: int):
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute('DELETE FROM banned WHERE user_id = ?', (user_id,))
        conn.commit()

def save_message(user_id: int, username: str, text: str) -> int:
    with sqlite3.connect(DB_NAME) as conn:
        c = conn.cursor()
        c.execute('INSERT INTO messages (user_id, username, text) VALUES (?, ?, ?)',
                 (user_id, username, text))
        conn.commit()
        return c.lastrowid

# ==================== ОБРАБОТЧИКИ ====================
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    
    if is_banned(user.id):
        await update.message.reply_text("🚫 Вы заблокированы.")
        return
    
    text = f"""<b>📋 ПРАВИЛА</b>

1. Угрозы = ЧС навсегда
2. Оскорбления = ЧС
3. Спам = ЧС
4. Попытки обмана = ЧС

━━━━━━━━━━━━━━━━
Я ничего не покупаю, не предлагать.
В случае проблем — отпишу сам.

📞 По вопросам: {ADMIN_USERNAME}

━━━━━━━━━━━━━━━━
Напишите ваш вопрос:"""
    
    await update.message.reply_text(text, parse_mode=ParseMode.HTML)

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    text = update.message.text
    
    if user.id == ADMIN_ID:
        # Админ может отвечать через кнопки, сообщения админа не сохраняем как вопросы
        if context.user_data.get('awaiting_answer'):
            await handle_answer_input(update, context)
        return
    
    if is_banned(user.id):
        await update.message.reply_text("🚫 Вы заблокированы.")
        return
    
    if len(text) < 5:
        await update.message.reply_text("❌ Сообщение слишком короткое. Напишите подробнее.")
        return
    
    if len(text) > 1000:
        await update.message.reply_text("❌ Сообщение слишком длинное. Максимум 1000 символов.")
        return
    
    msg_id = save_message(user.id, user.username or "нет", text)
    
    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📨 Ответить", callback_data=f'answer_{msg_id}')],
        [InlineKeyboardButton("🚫 Забанить", callback_data=f'ban_{user.id}')]
    ])
    
    await context.bot.send_message(
        ADMIN_ID,
        f"📨 <b>НОВОЕ СООБЩЕНИЕ #{msg_id}</b>\n\n"
        f"👤 @{user.username or 'нет'} (ID: {user.id})\n"
        f"💬 {text}\n\n"
        f"━━━━━━━━━━━━━━━━",
        parse_mode=ParseMode.HTML,
        reply_markup=keyboard
    )
    
    await update.message.reply_text(
        "✅ Сообщение отправлено. Ожидайте ответа.",
        reply_to_message_id=update.message.message_id
    )

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    
    if query.from_user.id != ADMIN_ID:
        await query.answer("❌ Нет доступа", show_alert=True)
        return
    
    if data.startswith('answer_'):
        msg_id = int(data.split('_')[1])
        context.user_data['answering'] = msg_id
        context.user_data['awaiting_answer'] = True
        
        await query.edit_message_text(
            f"📨 <b>ОТВЕТ НА СООБЩЕНИЕ #{msg_id}</b>\n\n"
            f"Введите ваш ответ:",
            parse_mode=ParseMode.HTML,
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("❌ Отмена", callback_data='cancel_answer')]
            ])
        )
    
    elif data.startswith('ban_'):
        user_id = int(data.split('_')[1])
        ban_user(user_id)
        await query.edit_message_text(f"🚫 Пользователь {user_id} забанен.")
    
    elif data == 'cancel_answer':
        context.user_data.pop('answering', None)
        context.user_data.pop('awaiting_answer', None)
        await query.edit_message_text("❌ Ответ отменён.")

async def handle_answer_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    
    if user.id != ADMIN_ID:
        return
    
    if not context.user_data.get('awaiting_answer'):
        return
    
    msg_id = context.user_data.get('answering')
    answer = update.message.text
    
    if not msg_id:
        await update.message.reply_text("❌ Нет активного сообщения для ответа.")
        context.user_data.pop('awaiting_answer', None)
        return
    
    with sqlite3.connect(DB_NAME) as conn:
        c = conn.cursor()
        c.execute('SELECT user_id FROM messages WHERE id = ?', (msg_id,))
        row = c.fetchone()
        
        if not row:
            await update.message.reply_text("❌ Сообщение не найдено")
            context.user_data.pop('answering', None)
            context.user_data.pop('awaiting_answer', None)
            return
        
        user_id = row[0]
        c.execute('UPDATE messages SET replied = 1 WHERE id = ?', (msg_id,))
        conn.commit()
    
    try:
        await context.bot.send_message(
            user_id,
            f"📨 <b>ОТВЕТ ОТ ПОДДЕРЖКИ</b>\n\n"
            f"━━━━━━━━━━━━━━━━\n"
            f"{answer}\n"
            f"━━━━━━━━━━━━━━━━\n\n"
            f"{ADMIN_USERNAME}",
            parse_mode=ParseMode.HTML
        )
        await update.message.reply_text(f"✅ Ответ на сообщение #{msg_id} отправлен!")
    except Exception as e:
        await update.message.reply_text(f"❌ Не удалось отправить: {e}")
    
    context.user_data.pop('answering', None)
    context.user_data.pop('awaiting_answer', None)

async def ban_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/ban ID")
        return
    user_id = int(context.args[0])
    ban_user(user_id)
    await update.message.reply_text(f"🚫 {user_id} забанен")

async def unban_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/unban ID")
        return
    user_id = int(context.args[0])
    unban_user(user_id)
    await update.message.reply_text(f"✅ {user_id} разбанен")

async def stats_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    with sqlite3.connect(DB_NAME) as conn:
        c = conn.cursor()
        total = c.execute('SELECT COUNT(*) FROM messages').fetchone()[0]
        replied = c.execute('SELECT COUNT(*) FROM messages WHERE replied = 1').fetchone()[0]
        banned = c.execute('SELECT COUNT(*) FROM banned').fetchone()[0]
    
    await update.message.reply_text(
        f"📊 <b>СТАТИСТИКА</b>\n\n"
        f"━━━━━━━━━━━━━━━━\n"
        f"📨 Всего сообщений: {total}\n"
        f"✅ Отвечено: {replied}\n"
        f"🚫 Забанено: {banned}",
        parse_mode=ParseMode.HTML
    )

# ==================== ЗАПУСК ====================
def main():
    app = Application.builder().token(BOT_TOKEN).build()
    
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("ban", ban_cmd))
    app.add_handler(CommandHandler("unban", unban_cmd))
    app.add_handler(CommandHandler("stats", stats_cmd))
    
    app.add_handler(CallbackQueryHandler(button_handler))
    
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    
    print("Бот поддержки @vultures_maniac запущен!")
    app.run_polling(drop_pending_updates=True)

if __name__ == "__main__":
    main()