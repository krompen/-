        await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))
    
    elif data.startswith("del_"):
        history_id = int(data.split("_")[1])
        delete_history(user_id, history_id)
        await query.edit_message_text("✅ УДАЛЕНО!", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 ИСТОРИЯ", callback_data="history")]]))
    
    elif data == "clear_history":
        delete_history(user_id)
        await query.edit_message_text("✅ ИСТОРИЯ ОЧИЩЕНА!", reply_markup=back_keyboard())
    
    elif data == "info":
        await query.edit_message_text(
            "🤖 TTS БОТ v3.0\n"
            "🎤 ТЕКСТ → ГОЛОС С ВЫБОРОМ\n"
            "🗣️ 6 ГОЛОСОВ\n"
            "👴 МУДРЫЙ ДЕД, БАБКА, РОБОТ И ДР.\n\n"
            "🔧 ТЕХНОЛОГИЯ: Google TTS\n"
            "💰 БЕСПЛАТНО",
            reply_markup=back_keyboard()
        )

async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text
    
    voice_id = get_user_voice(user_id)
    await context.bot.send_chat_action(chat_id=user_id, action="upload_voice")
    result = await text_to_voice(update, context, text, voice_id)
    
    if result and result.startswith("❌"):
        await update.message.reply_text(result, reply_markup=main_keyboard())

def main():
    if not TTS_AVAILABLE:
        print("❌ УСТАНОВИТЕ gTTS: pip install gTTS")
        return
    
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_handler(CallbackQueryHandler(button_handler))
    
    print("🚀 TTS БОТ ЗАПУЩЕН!")
    app.run_polling(drop_pending_updates=True)

if __name__ == "__main__":
    main()