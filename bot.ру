async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    question = update.message.text
    
    # Отправляем статус "печатает"
    await context.bot.send_chat_action(chat_id=user_id, action="typing")
    
    # Сохраняем вопрос
    save_message(user_id, "user", question)
    
    # Получаем историю
    history = get_conversation(user_id, 10)
    
    # Получаем ответ от рассказчика
    answer = get_storyteller_response(question, history)
    
    # Сохраняем ответ
    save_message(user_id, "assistant", answer)
    
    # Отправляем ответ
    await update.message.reply_text(answer, parse_mode="Markdown")
    
    # Кнопка для следующего вопроса
    await update.message.reply_text(
        "*Старик тушит окурок, зажигает новую сигарету*\n\n❓ **ЗАДАЙ ЕЩЁ ВОПРОС:**",
        reply_markup=main_keyboard(),
        parse_mode="Markdown"
    )

