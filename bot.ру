    data = query.data
    await query.answer()
    user_id = query.from_user.id
    
    if data == "back":
        current_voice = get_user_voice(user_id)
        current_voice_name = VOICES.get(current_voice, VOICES["old_man"])["name"]
        await query.edit_message_text(
            f"🎙️ ТЕКУЩИЙ ГОЛОС: {current_voice_name}\n\n⬇️ ВЫБЕРИ ДЕЙСТВИЕ:",
            reply_markup=main_keyboard()
        )
    
    elif data == "choose_voice":
        text = "🎙️ ВЫБЕРИ ГОЛОС:\n\n"
