# ========== БАЗА ДАННЫХ ==========
def init_db():
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        username TEXT,
        registered_at TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS conversations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        role TEXT,
        content TEXT,
        created_at TEXT
    )''')
    conn.commit()
    conn.close()

init_db()

# ========== ФУНКЦИИ БД ==========
def add_user(user_id, username):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    c.execute('INSERT OR IGNORE INTO users (user_id, username, registered_at) VALUES (?, ?, ?)', (user_id, username, now))
    conn.commit()
    conn.close()

def save_message(user_id, role, content):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    c.execute('INSERT INTO conversations (user_id, role, content, created_at) VALUES (?, ?, ?, ?)',
              (user_id, role, content, now))
    conn.commit()
    conn.close()

def get_conversation(user_id, limit=10):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    history = c.execute('SELECT role, content FROM conversations WHERE user_id = ? ORDER BY id DESC LIMIT ?', (user_id, limit)).fetchall()
    conn.close()
    return list(reversed(history))

def clear_history(user_id):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('DELETE FROM conversations WHERE user_id = ?', (user_id,))
    conn.commit()
    conn.close()

# ========== API OPENROUTER ==========
def get_storyteller_response(user_message, history):
    """Получает ответ от рассказчика через OpenRouter"""
    
    # Формируем сообщения с историей
    messages = [{"role": "system", "content": STORYTELLER_PROMPT}]
    
    for h in history:
        messages.append({"role": h[0], "content": h[1]})
    
    messages.append({"role": "user", "content": user_message})
    
    try:
        response = requests.post(
            url="https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json"
            },
            json={
                "model": "google/gemini-2.0-flash-exp:free",
                "messages": messages,
                "max_tokens": 500,
                "temperature": 0.9
            },
            timeout=30
        )
        
        if response.status_code == 200:
            result = response.json()
            return result["choices"][0]["message"]["content"]
        else:
            return f"*Тушит сигарету, задумчиво смотрит в потолок*\n\n— Что-то сегодня голос сорвал, мил человек. Давай попозже вернёмся к разговору.\n\n*Зажигает новую сигарету, уходит в туман*"
    except Exception as e:
        return f"*Тушит окурок в пепельнице*\n\n— Техника подвела, мил друг. Но я здесь, просто переспроси.\n\n*Зажигает новую сигарету*"

