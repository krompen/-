        voice_name = VOICES[voice_id]["name"]
        
        await query.edit_message_text(
            f"✅ ГОЛОС ИЗМЕНЁН: {voice_name}\n\n"
            f"⬇️ ТЕПЕРЬ ПРОСТО ОТПРАВЬ ТЕКСТ!",
            reply_markup=back_keyboard()
        )
    
    elif data == "history":
        history = get_history(user_id, 10)
